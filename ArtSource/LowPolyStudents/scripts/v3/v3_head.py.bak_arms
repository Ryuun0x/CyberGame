"""v3 head + neck loft, ears and the painted face texture (exec'd after v3_model.py)."""

# Rings: (u = height above chin / HEAD_H, axis y offset / HEAD_H, radii / HEAD_H at CTRL_A degrees from the front)
CTRL_A = [0, 20, 40, 60, 90, 120, 150, 180]
HEAD_RINGS = [   # rounder retro-anime boy head: broad cranium and cheeks, low eye line, short round chin
    (0.975, 0.03, [.13, .13, .135, .14, .145, .155, .165, .17]),
    (0.93, 0.02, [.25, .25, .255, .26, .265, .28, .29, .295]),
    (0.85, 0.01, [.34, .34, .345, .35, .355, .37, .39, .40]),
    (0.74, 0.0, [.385, .385, .39, .395, .40, .41, .43, .435]),
    (0.62, 0.0, [.395, .40, .405, .41, .41, .415, .435, .44]),
    (0.51, 0.0, [.395, .40, .405, .405, .405, .40, .42, .425]),
    (0.40, 0.0, [.39, .395, .40, .40, .395, .38, .395, .40]),
    (0.30, 0.0, [.40, .395, .39, .385, .37, .34, .355, .36]),
    (0.21, 0.0, [.385, .38, .37, .355, .33, .28, .30, .31]),
    (0.12, 0.01, [.36, .35, .335, .31, .27, .21, .23, .26]),
    (0.05, 0.02, [.32, .30, .265, .22, .18, .18, .21, .245]),
    (0.0, 0.03, [.26, .23, .18, .15, .15, .165, .20, .24]),
    (-0.048, 0.097, [.142, .142, .146, .154, .158, .163, .171, .183]),     # thin neck
    (-0.17, 0.118, [.166, .166, .166, .171, .174, .174, .174, .178]),
    (-0.32, 0.129, [.252, .252, .252, .258, .279, .268, .252, .252]),
    (-0.43, 0.129, [.268, .268, .268, .279, .311, .29, .268, .268]),
]
HEAD_Y = 0.07            # head sits this far (x HEAD_H) back, so the neck rises straight from the shoulders
SEG_A = [0, 22, 45, 68, 90, 115, 145]   # one side; mirrored + 180 -> 12 segments, so the facets show

def _interp_r(rs, a):
    """Periodic Catmull-Rom over CTRL_A (symmetric profile), a in degrees."""
    a = abs(a)
    xs = [-CTRL_A[1]] + CTRL_A + [360 - CTRL_A[-2]]; ys = [rs[1]] + rs + [rs[-2]]
    for i in range(1, len(xs) - 2):
        if xs[i] <= a <= xs[i + 1]: break
    t = (a - xs[i]) / (xs[i + 1] - xs[i])
    p0, p1, p2, p3 = ys[i - 1], ys[i], ys[i + 1], ys[i + 2]
    return 0.5 * (2 * p1 + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t + (-p0 + 3 * p1 - 3 * p2 + p3) * t ** 3)

def head_point(u, a, ring=None):
    """Point on the head loft at height u, angle a (degrees from the front, +ve toward +X)."""
    if ring is None:
        rr = HEAD_RINGS
        for i in range(len(rr) - 1):
            if rr[i + 1][0] <= u <= rr[i][0]: break
        t = (u - rr[i][0]) / (rr[i + 1][0] - rr[i][0])
        yo = lerp(rr[i][1], rr[i + 1][1], t); r = lerp(_interp_r(rr[i][2], a), _interp_r(rr[i + 1][2], a), t)
    else:
        u, yo, rs = ring; r = _interp_r(rs, a)
    t = math.radians(a)
    return V((math.sin(t) * r * HEAD_H, (yo + HEAD_Y - math.cos(t) * r) * HEAD_H, CHIN_Z + u * HEAD_H))

def head_weights(z):
    """head <-> neck <-> chest blend by height."""
    h = ss(1.385, 1.43, z); c = ss(1.36, 1.315, z) * (1 - h)
    return {k: v for k, v in (('head', h), ('neck', 1 - h - c), ('chest', c)) if v > 1e-4}

def build_head(base_bvh=None):
    """base_bvh: snap the lower neck rings onto the base body (2 mm inside) so garment necklines hug it."""
    angs = SEG_A + [180] + [-a for a in reversed(SEG_A[1:])]
    mb = MB(); rings = []
    for ring in HEAD_RINGS:
        row = []
        for a in angs:
            p = head_point(0, a, ring)
            if base_bvh and ring[0] <= -0.17:
                c = V((0, (ring[1] + HEAD_Y) * HEAD_H, p.z)); d = V((p.x, p.y - c.y, 0)).normalized()
                hit, _, _, dist = base_bvh.ray_cast(c, d, 0.2)
                own = (p - c).length   # the upper snapped ring may not flare far past the neck profile: a straight
                cap = own + (0.01 if ring[0] > -0.2 else 0.05)    # face across the concave neck-shoulder fillet pokes out
                if hit is not None: p = c + d * min(max(dist - 0.012, 0.045), cap)   # well inside the shirt/tee necklines
            row.append(mb.add(p, head_weights(p.z)))
        rings.append(row)
    n = len(angs)
    for r0, r1 in zip(rings, rings[1:]):
        for i in range(n):
            j = (i + 1) % n
            mb.face([r0[i], r0[j], r1[j], r1[i]], 'Face')
    top = mb.add(V((0, (0.035 + HEAD_Y) * HEAD_H, CHIN_Z + HEAD_H)), {'head': 1})
    for i in range(n): mb.face([rings[0][(i + 1) % n], rings[0][i], top], 'Face')
    for ring, idx in zip(HEAD_RINGS, rings):     # nose: pull the front column out into a small wedge
        k = ss(0.34, 0.30, ring[0]) * ss(0.20, 0.25, ring[0])   # small, short nose
        if k > 0: mb.v[idx[0]] += V((0, -0.012 * HEAD_H * k, 0))
    return mb

def build_ears():
    """Modelled ears: a flattened shell with a rim, sunk slightly into the head side."""
    mb = MB()
    outline = [(0.0, 0.040), (-0.012, 0.036), (-0.018, 0.024), (-0.019, 0.008), (-0.014, -0.010), (-0.006, -0.024),
               (0.004, -0.030), (0.012, -0.024), (0.014, -0.006), (0.012, 0.016), (0.008, 0.032)]   # (back, up)
    n = len(outline); w = {'head': 1.0}
    for sg in (1, -1):
        c = head_point(0.31, 96); c = V((sg * (c.x - 0.004), c.y, c.z))
        out = V((sg, 0.12, 0)).normalized(); bk = V((0, 1, 0)); up = V((0, 0, 1))
        outline_k = [(a * HK, b * HK) for a, b in outline]
        base = [mb.add(c + bk * a * 0.9 + up * b, w) for a, b in outline_k]
        rim = [mb.add(c + bk * a + up * b + out * (0.006 + 0.005 * (b / HK + 0.03) / 0.07) * HK, w) for a, b in outline_k]
        inner = [mb.add(c + bk * (a * 0.55 - 0.002) + up * (b * 0.6 - 0.002) + out * 0.007 * HK, w) for a, b in outline_k]
        ctr = mb.add(c + out * 0.006 - up * 0.002, w)
        for i in range(n):
            j = (i + 1) % n
            for f, m in (([base[i], base[j], rim[j], rim[i]], 'Skin'), ([rim[i], rim[j], inner[j], inner[i]], 'Skin'),
                         ([inner[i], inner[j], ctr], 'Ear_Inner')):
                mb.face(f if sg > 0 else f[::-1], m)
    return mb

# ------------------------------------------------------------------ face texture (painted, front projection)
FK = HEAD_H / 0.27        # face paint is authored for a 0.27 m head and scales with it
FACE_X = 0.125 * FK; FACE_Z0 = CHIN_Z - 0.02; FACE_SZ = 2 * FACE_X

def face_uv(mat, co, n):
    if mat == 'Face' and n.y < -0.05:
        return ((co.x + FACE_X) / FACE_SZ, (co.z - FACE_Z0) / FACE_SZ)
    return (0.004, 0.004)      # plain skin texel

def _hex(h): return np.array([int(h[i:i + 2], 16) / 255 for i in (1, 3, 5)], np.float32)

class Canvas:
    """sRGB float canvas over a metric window; shapes are signed-distance fields, anti-aliased by coverage."""
    def __init__(s, x0, z0, size, res, base, hard=False):
        s.px = size / res; s.res = res; s.x0, s.z0, s.size, s.hard = x0, z0, size, hard
        xs = (np.arange(res) + 0.5) * s.px + x0; zs = (np.arange(res) + 0.5) * s.px + z0
        s.X, s.Z = np.meshgrid(xs, zs)              # row 0 = bottom (Blender image origin)
        s.img = np.ones((res, res, 3), np.float32) * _hex(base)
    def put(s, f, col, a=1.0):
        cov = ((f < 0.5 * s.px).astype(np.float32) if s.hard else np.clip(0.5 - f / s.px, 0, 1))[..., None] * a   # hard: >= 1 px lines
        c = _hex(col) if isinstance(col, str) else col
        s.img[:] = s.img * (1 - cov) + c * cov
    def ell(s, cx, cz, rx, rz, x=None):
        x = s.X if x is None else x
        return (np.sqrt(((x - cx) / rx) ** 2 + ((s.Z - cz) / rz) ** 2) - 1) * min(rx, rz)
    def seg(s, ax, az, bx, bz, w0, w1, x=None):
        x = s.X if x is None else x
        dx, dz = bx - ax, bz - az; L2 = dx * dx + dz * dz
        t = np.clip(((x - ax) * dx + (s.Z - az) * dz) / L2, 0, 1)
        return np.sqrt((x - ax - t * dx) ** 2 + (s.Z - az - t * dz) ** 2) - (w0 + (w1 - w0) * t)
    def poly(s, pts, w0, w1, x=None):
        n = len(pts) - 1
        return np.minimum.reduce([s.seg(*pts[i], *pts[i + 1], lerp(w0, w1, i / n), lerp(w0, w1, (i + 1) / n), x) for i in range(n)])
    def fill(s, pts, x=None):
        """filled polygon (even-odd), signed distance approximated by distance to the outline"""
        x = s.X if x is None else x
        inside = np.zeros(x.shape, bool); n = len(pts)
        for i in range(n):
            (ax, az), (bx, bz) = pts[i], pts[(i + 1) % n]
            cond = (az > s.Z) != (bz > s.Z)
            xi = ax + (s.Z - az) * (bx - ax) / ((bz - az) if bz != az else 1e-9)
            inside ^= cond & (x < xi)
        d = s.poly(list(pts) + [pts[0]], 0, 0, x)
        return np.where(inside, -d, d)
    def save(s, path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        nm = os.path.basename(path)
        im = bpy.data.images.get(nm)
        if im: bpy.data.images.remove(im)
        im = bpy.data.images.new(nm, s.res, s.res)
        im.pixels.foreach_set(np.concatenate([s.img, np.ones((s.res, s.res, 1), np.float32)], 2).ravel())
        im.filepath_raw = path; im.file_format = 'PNG'; im.save()
        return im

EYE = dict(u=0.40, x=0.05)
def paint_face(path, res=80):
    """Retro anime boy face (after the PS1-style reference): big dark eyes under a heavy black lash line,
    straight brows, a tiny nose mark, a small closed smile and faint blush hatching."""
    c = Canvas(-FACE_X, FACE_Z0, FACE_SZ, res, PAL['Skin'][0], hard=True)   # low-res, aliased: pixel art
    c.X = c.X / FK; c.Z = CHIN_Z + (c.Z - CHIN_Z) / FK; c.px /= FK; Z = c.Z; H0 = 0.27
    EZ = CHIN_Z + EYE['u'] * H0; cx = EYE['x']
    for sg in (1, -1):
        x = c.X * sg                     # paint the +X eye; the other is the mirror
        x0, x1 = cx - 0.026, cx + 0.027
        t = np.clip((x - x0) / (x1 - x0), 0, 1)
        zU = EZ + 0.006 + 0.018 * np.sin(np.pi * t ** 0.8) - 0.006 * t
        zL = EZ - 0.020 + 0.006 * t - 0.003 * np.sin(np.pi * t)
        box = np.maximum(x0 - x, x - x1)
        sclera = np.maximum(np.maximum(zL - Z, Z - zU), box)
        c.put(sclera, '#FBF6F1')
        ix, iz = cx + 0.0015, EZ - 0.001
        c.put(np.maximum(c.ell(ix, iz, 0.0165, 0.0225, x), sclera), '#2E170C')
        grad = np.clip((Z - (iz - 0.02)) / 0.032, 0, 1)[..., None]
        c.put(np.maximum(c.ell(ix, iz - 0.003, 0.0125, 0.0165, x), sclera), _hex('#94512A') * (1 - grad) + _hex('#3E1F10') * grad)
        c.put(np.maximum(c.ell(ix, iz + 0.001, 0.0075, 0.0105, x), sclera), '#130905')
        c.put(c.ell(ix - 0.0055, iz + 0.0075, 0.0045, 0.0052, x), '#FFFFFF')
        c.put(c.ell(ix + 0.006, iz - 0.0095, 0.0019, 0.0019, x), '#FFFFFF', 0.9)
        lash = c.poly([(x0 - 0.002, EZ + 0.002), (x0 + 0.012, EZ + 0.021), (cx + 0.006, EZ + 0.025),
                       (x1 - 0.003, EZ + 0.017), (x1 + 0.008, EZ + 0.007)], 0.0016, 0.0032, x)
        c.put(np.minimum(lash, np.maximum(np.maximum(Z - (zU + 0.0042), zU - 0.0008 - Z), box)), '#17100D')
        c.put(c.poly([(cx + 0.004, EZ - 0.0205), (x1 - 0.001, EZ - 0.0145), (x1 + 0.003, EZ - 0.011)], 0.0006, 0.0011, x), '#3A2016')
        c.put(c.poly([(0.018, EZ + 0.037), (0.04, EZ + 0.043), (0.07, EZ + 0.042)], 0.0032, 0.0019, x), '#3A1A10')
        for k in range(3):   # faint blush hatching
            bx = cx + 0.004 + k * 0.0055
            c.put(c.seg(bx, EZ - 0.033, bx - 0.0035, EZ - 0.040, 0.0006, 0.0006, x), '#E48C78', 0.55)
    NZ = CHIN_Z + 0.255 * H0
    c.put(c.poly([(-0.0015, NZ + 0.006), (-0.003, NZ), (0.0005, NZ - 0.0015)], 0.0005, 0.0009), '#CF8766', 0.8)
    MZ = CHIN_Z + 0.135 * H0
    c.put(c.poly([(-0.009, MZ + 0.0016), (-0.004, MZ), (0.004, MZ), (0.009, MZ + 0.0016)], 0.0008, 0.0008), '#7E3A2C')
    c.put(c.ell(0.0, MZ - 0.0045, 0.005, 0.0013), '#E2A07E', 0.5)
    return c.save(path)
